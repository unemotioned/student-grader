CXX = g++
CXXFLAGS = -Wall -Wextra -std=c++20

SRC = $(wildcard src/*.cpp)
BUILD_DIR = build
TARGET = $(BUILD_DIR)\main.exe

all: $(TARGET)

$(TARGET): $(SRC)
	@if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"
	$(CXX) $(CXXFLAGS) -o $@ $^

clean:
	@if exist "$(BUILD_DIR)" rmdir /S /Q "$(BUILD_DIR)"

.PHONY: all clean
